{
  "id": "copiloto_voz",
  "title": "Copiloto de voz",
  "description": "Frases grabadas cuando pasa algo en el coche: bienvenida al subir, fin del viaje, poco combustible (con la gasolinera más cercana en Waze en tu iPhone), repostaje, posible hielo y pausa tras dos horas",
  "version": "0.1.0",
  "vendor": "custom",
  "autostart": true,
  "mguInternet": true,
  "loggingId": "OAV1",
  "iconGlyph": "VOZ",
  "shared": [
    "tz.js"
  ],
  "fonts": "es",
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "encendido / apagado: bienvenida y fin del viaje",
      "VehicleCondition": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "una puerta abierta: la bienvenida",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "combustible y autonomía",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "temperatura exterior: aviso de hielo",
      "ExteriorTemperature": "s"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_optional": "el gestor de audio: conectar la voz a los altavoces (como RideTube)",
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect"
      ],
      "listOfMainConnections": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "el reproductor de BMW: reproducir la frase (como RideTube)",
      "_instances": "OapGenericMedia",
      "_methods": [
        "sendButtonEvent",
        "playFile"
      ],
      "_broadcasts": [
        "playbackErrorEvent"
      ],
      "playerState": "rs",
      "currentItemTime": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Copiloto de voz",
      "buttons": [
        [
          "BTN_TEST",
          "Probar la siguiente frase"
        ],
        [
          "BTN_PHONE",
          "Probar el aviso al iPhone"
        ],
        [
          "BTN_SETTINGS",
          "Ajustes"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "on_bienvenida",
      "label": "Bienvenida al subir",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_fin_viaje",
      "label": "Fin del viaje al apagar",
      "type": "bool",
      "default": true
    },
    {
      "key": "on_combustible",
      "label": "Aviso de poco combustible",
      "type": "bool",
      "default": true
    },
    {
      "key": "fuelKm",
      "label": "Avisar con una autonomía de",
      "type": "number",
      "unit": "km",
      "default": 50,
      "steps": [
        30,
        40,
        50,
        60,
        70,
        80,
        100
      ]
    },
    {
      "key": "phone",
      "label": "Enviar la gasolinera al iPhone (ntfy + Waze)",
      "type": "bool",
      "default": true
    },
    {
      "key": "brand",
      "label": "Gasolinera",
      "type": "choice",
