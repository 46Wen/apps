# mgu-audio-level (46Wen): the music's level for Ambient config's Music wave, from SmartXbar's ring buffers, read only.
# Idle (one look a second at a file) unless the Music wave or the Audio probe app wants it; then 20 looks a second.
[Unit]
Description=mgu-audio-level: the music's level from SmartXbar's buffers (read only), for the Music wave

[Service]
# root, as Audio probe's tool: the first try ran as a dynamic user in mgu_alsa / mgu_avbs and never wrote a level in
# the car (0.1.0). It only maps SmartXbar's buffers read only and writes its own two files in /dev/shm.
User=root
NoNewPrivileges=yes
ExecStart=/var/opt/mgu-audio-level/current/mgu-audio-level
Restart=on-failure
RestartSec=10
Slice=background.slice
Nice=19
IOSchedulingClass=idle
CPUQuota=5%
MemoryLimit=16M
TasksMax=4
LimitCORE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
