# mgu-audio-probe (46Wen): a read-only look at the head unit's sound (probe.sh), only when the Audio probe app asks
# (mgu-audio-probe.path, on its request file). It runs for a second or two and stops; nothing waits for it.
[Unit]
Description=mgu-audio-probe: read-only report on how the head unit's sound is built
RequiresMountsFor=/var/opt
# the app's button pressed over and over: at most 5 reports a minute
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# (not RemainAfterExit: each request runs it again; the path unit is what stays active)
Type=oneshot
# root: the other processes' open sound devices (/proc/<pid>/fd), the kernel log and the sound servers' sockets
User=root
ExecStart=/bin/sh /var/opt/mgu-audio-probe/current/probe.sh
TimeoutStartSec=120
# never ahead of the HMI or the sound
Slice=background.slice
Nice=19
IOSchedulingClass=idle
CPUQuota=20%
MemoryLimit=32M
LimitCORE=1
StandardOutput=journal
StandardError=journal
