# mgu-audio-probe (46Wen): the report only when the Audio probe app asks for it (its "Crear informe" button, once the
# music plays and a USB stick is in): the app writes the request file, this starts the probe. Nothing runs by itself.
[Unit]
Description=mgu-audio-probe: waits for the Audio probe app's request

[Path]
PathExists=/dev/shm/mgu-audio-probe.request
Unit=mgu-audio-probe.service

[Install]
WantedBy=paths.target
